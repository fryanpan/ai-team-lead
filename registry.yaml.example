# Project Registry
# Maps project names to their local paths, GitHub repos, and tool config.
# The metaproject reads from main worktrees (~/dev/{project}) and proposes changes via GitHub PRs.
#
# Copy this file to registry.yaml and fill in your own projects.

# Optional. Read by the morning-digest and weekly-plan skills.
# calendars:
#   primary: you@example.com
# calendar_exclusions:
#   - a recurring block that is not a meeting

# This machine's own values. Scripts and skills read them from here instead of
# carrying them in the repo: scripts/local_config.py is the reader, and
# `python3 scripts/local_config.py` lists which keys are set. Every value below
# is a placeholder. A script that cannot read a key it needs stops and says
# which one; none of them falls back to a built-in value.
# Keep each value on one line. Quote a value that holds a `#` or JSON.
# Never leave a key with no value: a bare `  name:` line is read as a project.
# Delete the line of a key you do not need yet. install_healthcheck.py needs
# every key that a check it runs uses, and names the ones it could not read.
local:
  # Local address of the claude-hive message broker (the hive's README names
  # its port).
  hive_url: http://127.0.0.1:8000
  # Local addresses of the GitHub channel broker and the Notion receiver.
  github_broker_url: http://127.0.0.1:8001
  notion_receiver_url: http://127.0.0.1:8002
  # Public hostnames of the tunnels in front of the Notion receiver and the
  # workspaces board. Hostname only, no scheme or path.
  notion_tunnel_host: notion.example.com
  board_tunnel_host: board.example.com
  # launchd job labels (`launchctl list` shows yours).
  launchd_notion_receiver: com.example.notion-receiver
  launchd_github_broker: com.example.github-broker
  launchd_notion_tunnel: com.example.notion-tunnel
  launchd_board_tunnel: com.example.board-tunnel
  # The workspaces board server's job, and the label it had before a rename.
  # A job that is live under either label passes the check. If yours was never
  # renamed, give the same label twice.
  launchd_board_server: com.example.board-server
  launchd_board_server_former: com.example.board-server-old
  # The three jobs install_healthcheck.py creates: the health check, the
  # machine guard and the log rotation. Each needs its own label: only the
  # board server pair above may share one. Pick the labels before the first
  # install. To change one later, remove the old job yourself first: the
  # installer stops when a job runs one of its programs under another label.
  launchd_healthcheck: com.example.fleet-healthcheck
  launchd_guard: com.example.fleet-guard
  launchd_log_rotate: com.example.fleet-log-rotate
  # Log files of the same two daemons.
  notion_receiver_log: ~/Library/Logs/notion-receiver.log
  github_broker_log: ~/Library/Logs/github-broker.log
  # Discord state. `discord_state_subdir` is the folder inside a project that
  # holds a peer's own Discord state, `discord_allowlist_file` is the name of
  # the allowlist file your Discord plugin keeps there, and
  # `discord_empty_allowlist` is the content of an allowlist that admits
  # nobody, in that plugin's format. `no_discord_state_dir` is a folder outside
  # every repo for peers with no Discord state of their own.
  discord_state_subdir: .claude/discord
  discord_allowlist_file: allowlist.json
  discord_empty_allowlist: '{}'
  no_discord_state_dir: ~/.config/team-lead/empty-discord-state
  # The Claude Code flag that loads an MCP server as a development channel
  # (`claude --help` lists it). respawn.py passes it for a direct channel server.
  dev_channel_flag: --your-channel-flag

projects:
  my-app:
    path: ~/dev/my-app
    repo: your-username/my-app
    linear:
      team_id: 00000000-0000-0000-0000-000000000000
      team_key: APP
    docs:
      learnings: docs/process/learnings.md
      retros: docs/process/retrospective.md
      decisions: docs/product/decisions.md
      claude_md: CLAUDE.md
    skills_dir: .claude/skills
    rules_dir: .claude/rules

  side-project:
    path: ~/dev/side-project
    repo: your-username/side-project
    linear:
      team_id: 00000000-0000-0000-0000-000000000001
      team_key: SID
    docs:
      learnings: docs/process/learnings.md
      retros: docs/process/retrospective.md
      decisions: docs/product/decisions.md
      claude_md: CLAUDE.md
    skills_dir: .claude/skills
    rules_dir: .claude/rules

  # A project you're joining / helping improve.
  # Same schema — just a different repo and possibly different tools.
  team-frontend:
    path: ~/dev/team-frontend
    repo: SomeOrg/team-frontend
    notion:
      board: https://www.notion.so/your-board-id
      meeting_notes: https://www.notion.so/your-meeting-notes-id
    docs:
      learnings: context/process/learnings.md
      retros: context/process/retrospective.md
      decisions: context/product/decisions.md
      claude_md: CLAUDE.md
    skills_dir: .claude/skills
    rules_dir: .claude/rules

  # A local-only project — just a folder on disk, no git repo.
  # Omit `repo` and the metaproject treats it as local-only: it skips ALL git
  # commands for this project (no pull / fetch / status, no PR flow). Edits go
  # straight to the folder. Good for synced folders (e.g. a Google Drive
  # subfolder), scratch dirs, or any working folder that isn't version-controlled.
  # `respawn: true` still works — respawn.py never touches git, it just relaunches
  # `claude --continue` in the folder.
  local-notes:
    path: ~/Documents/local-notes
    respawn: true
    session_name: "Local Notes"
    docs:
      claude_md: CLAUDE.md

  # Optional: team context for a project you're joining.
  # Helps the metaproject understand the team's stack and goals.
  team-context:
    team:
      - name: Teammate Name
        role: Frontend
        notes: Comfortable with Claude Code, good at larger features
    stack:
      languages: [Python, TypeScript]
      tools:
        ticketing: Notion
        docs: Notion
        ci_cd: GitHub Actions
        repo: GitHub
